{
  "name": "sacr",
  "displayName": "sacr — AI code reviewer",
  "description": "Run sacr against the current diff or file and render findings in the Problems panel.",
  "version": "0.1.0",
  "publisher": "disseqt",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:sacr.reviewCurrentDiff",
    "onCommand:sacr.reviewFile"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sacr.reviewCurrentDiff",
        "title": "sacr: Review Current Diff"
      },
      {
        "command": "sacr.reviewFile",
        "title": "sacr: Review Current File"
      }
    ],
    "configuration": {
      "title": "sacr",
      "properties": {
        "sacr.binaryPath": {
          "type": "string",
          "default": "sacr",
          "description": "Path to the sacr binary. Use an absolute path if it is not on PATH."
        },
        "sacr.format": {
          "type": "string",
          "default": "json",
          "enum": ["json"],
          "description": "Output format sacr should emit. Only 'json' is consumed by this extension."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
