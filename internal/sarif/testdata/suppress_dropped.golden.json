{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "zreview",
          "version": "v0.2.0",
          "informationUri": "https://github.com/shubam-disseqt/z-code-reviewer",
          "rules": [
            {
              "id": "scanner:semgrep/gone",
              "name": "gone",
              "shortDescription": {
                "text": "gone"
              }
            },
            {
              "id": "scanner:semgrep/kept",
              "name": "kept",
              "shortDescription": {
                "text": "kept"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "scanner:semgrep/kept",
          "level": "note",
          "message": {
            "text": "kept"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "a.go"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "zreview/v1": "fp-1"
          }
        }
      ]
    }
  ]
}
